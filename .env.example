# Copy to .env.local for development. Never commit a filled-in copy.

# Signs the form token that proves we served the survey and when. Without it
# the minimum-duration check is forgeable. Required in production — the app
# refuses to render the survey rather than fall back to a known value.
#   openssl rand -base64 32
FORM_TOKEN_SECRET=

# Salts the same-day handle used for rate limiting and duplicate detection.
# Rotate freely: rotating it only means one day's duplicate detection resets,
# and it is never written anywhere. Required in production.
#   openssl rand -base64 32
IDENTITY_SECRET=

# Cloudflare Turnstile. When unset, verification is skipped in development and
# REFUSED in production — a missing key is a misconfiguration, not a reason to
# accept unverified submissions.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Absolute origin, used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Minimum seconds-as-ms a form must be open before submission is accepted.
# Defaults to 20000. Lower it only for automated tests.
FORM_MIN_FILL_MS=

# --- subscriber list: a SEPARATE database ---------------------------------
# Must point at a different instance from DATABASE_URL, with its own
# credential. The separation is the anonymity boundary (CLAUDE.md §4); a
# single connection serving both would make the site's central claim false.
SUBSCRIBER_DATABASE_URL=

# Signs confirmation and unsubscribe links. Derived per address, so no token
# is ever stored. Required in production.
#   openssl rand -base64 32
SUBSCRIBER_TOKEN_SECRET=

# Resend, used as a transport only — never its Audiences or Contacts API.
RESEND_API_KEY=
EMAIL_FROM="whatweearn <hello@example.org>"

# --- legal identity -------------------------------------------------------
# GDPR requires an identifiable data controller with a working contact
# address. Until these are set the privacy page renders a visible "not ready
# to collect data" alert — a policy that silently omits its controller looks
# compliant and is not.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTROLLER_ADDRESS=

# Where the footer's "Source" link points.
NEXT_PUBLIC_SOURCE_URL=https://github.com/whatweearn/website
